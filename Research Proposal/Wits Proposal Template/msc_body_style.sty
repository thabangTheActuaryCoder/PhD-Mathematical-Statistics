% =============================================================
% Body styling, following the candidate's MSc dissertation:
% 12pt serif, 25 mm margins, one-and-a-half spacing, natbib author-year
% citations, titlesec headings, fancyhdr running heads, and the same
% theorem environments.
%
% The cover pages are NOT produced here. They are built as a separate
% two-page PDF under "Cover Page/src/" and pulled in with \includepdf,
% the same arrangement the MSc dissertation uses.
% =============================================================

% Wits palette, from the university's own stylesheet
\usepackage{xcolor}
\definecolor{witsnavy}{HTML}{003B5C}
\definecolor{witsgold}{HTML}{FFA300}
\definecolor{witsblue}{HTML}{407EC9}
\definecolor{witsmaroon}{HTML}{9B2242}

% Page layout and spacing, as in the MSc dissertation
\usepackage[T1]{fontenc}
\usepackage[a4paper,left=25mm,right=25mm,top=25mm,bottom=25mm]{geometry}
\usepackage{setspace}
\onehalfspacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}

% Cover pages are included as a PDF
\usepackage{pdfpages}
\usepackage{tikz}

% =============================================================
% Mathematics
% =============================================================
\usepackage{amsmath, amssymb, amsthm}
\usepackage{mathrsfs}

% =============================================================
% General Formatting
% =============================================================
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{float}
\usepackage{etoolbox}
\usepackage{algorithm}
\usepackage{algpseudocode}
\usepackage{rotating}
\usepackage{todonotes}
\usepackage[autostyle]{csquotes}
\usepackage[toc,page]{appendix}

% =============================================================
% Code Listings
% =============================================================
\usepackage{listings}
\lstset{
	language=Python,
	basicstyle=\ttfamily\footnotesize,
	keywordstyle=\color{blue},
	commentstyle=\color{gray},
	stringstyle=\color{red!60!black},
	numbers=left,
	numberstyle=\tiny\color{gray},
	numbersep=8pt,
	frame=single,
	framesep=4pt,
	breaklines=true,
	showstringspaces=false,
	tabsize=4,
	captionpos=b,
	aboveskip=10pt,
	belowskip=10pt
}

% =============================================================
% Figures, Tables and Graphics
% =============================================================
\usepackage{graphicx}
\usepackage{subcaption}
\usepackage{booktabs}
\usepackage{multirow}
\usepackage{array}
\usepackage{longtable}
\usepackage{threeparttable}

% =============================================================
% TikZ and framed panels, as in the MSc dissertation
% =============================================================
\usetikzlibrary{positioning, arrows.meta, fit, backgrounds,
	shapes.geometric, decorations.pathreplacing}
\usepackage[framemethod=TikZ]{mdframed}

\definecolor{framegray}{HTML}{E0E0E0}
\definecolor{panelcream}{HTML}{F5F5EF}

\newmdenv[
	backgroundcolor=panelcream,
	linecolor=witsnavy,
	linewidth=1pt,
	roundcorner=6pt,
	innertopmargin=10pt,
	innerbottommargin=10pt,
	innerleftmargin=12pt,
	innerrightmargin=12pt,
	skipabove=10pt,
	skipbelow=10pt
]{frameworkbox}

% =============================================================
% Citations: natbib author-year, as in the MSc dissertation
% (the source template used apacite)
% =============================================================
\usepackage{natbib}
\setcitestyle{authoryear,open={(},close={)}}

% =============================================================
% Hyperlinks, in the Wits palette
% =============================================================
\usepackage[
	colorlinks=true,
	linkcolor=witsnavy,
	citecolor=witsnavy,
	urlcolor=witsnavy,
	hyperfootnotes=true,
	pagebackref=true
]{hyperref}
\usepackage{doi}
\renewcommand{\doitext}{}

% "Cited on page(s) ..." in the bibliography, as in the MSc dissertation
\renewcommand*{\backref}[1]{}
\renewcommand*{\backrefalt}[4]{%
	\ifcase #1 %
	(Not cited.)%
	\or
	(Cited on p.~#2.)%
	\else
	(Cited on pp.~#2.)%
	\fi
}

% =============================================================
% Theorem Environments
% =============================================================
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{assumption}{Assumption}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}

% =============================================================
% Equation numbering
% =============================================================
\numberwithin{equation}{section}
\DeclareMathOperator*{\esssup}{ess\,sup}

% =============================================================
% Header and Footer
% =============================================================
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
% The MSc sets only \leftmark from a section and reads \rightmark in the
% header, which leaves the head blank in a document with no subsections.
% Sections set both marks here, so the head is populated either way.
\renewcommand{\sectionmark}[1]{\markboth{\thesection\quad #1}{\thesection\quad #1}}
\renewcommand{\subsectionmark}[1]{\markright{\thesubsection\quad #1}}
\fancyhead[L]{\nouppercase{\rightmark}}
\fancyhead[R]{\thepage}

% =============================================================
% Heading Formatting
% =============================================================
\titleformat{\section}
{\normalfont\Large\bfseries}
{\thesection}
{1em}
{}

\titleformat{\subsection}
{\normalfont\large\bfseries}
{\thesubsection}
{1em}
{}

\titleformat{\subsubsection}
{\normalfont\normalsize\bfseries}
{\thesubsubsection}
{1em}
{}

% =============================================================
% Paragraph handling
% =============================================================
\widowpenalty=10000
\clubpenalty=10000
\interlinepenalty=1000
\usepackage{ragged2e}
\justifying
\sloppy

% =============================================================
% Captions
% =============================================================
\usepackage{caption}
\DeclareCaptionLabelSeparator{twospaces}{\space\space}
\captionsetup{
	labelsep=twospaces,
	labelfont={it},
	textfont={it},
	format=hang
}

\usepackage{tocloft}
\renewcommand{\cfttabpresnum}{}
\renewcommand{\cfttabaftersnum}{\space\space}
\settowidth{\cfttabnumwidth}{Table XX\space\space}
\renewcommand{\cftfigpresnum}{}
\renewcommand{\cftfigaftersnum}{\space\space}
\settowidth{\cftfignumwidth}{Figure XX\space\space}
